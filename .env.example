# Copy to .env and fill in your values.
# Never commit .env — it is gitignored.

# Optional — both already default to the local bilore-infra compose setup.
# DATABASE_URL=postgres://bilore:bilore@localhost:5432/bilore
# NATS_URL=nats://localhost:4222

# Required for Telegram alerts — without these, alerts are logged only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
